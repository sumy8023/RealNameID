<Window x:Class="RealName.SimpleClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="实名上机客户端"
        Background="{StaticResource BackgroundBrush}"
        Width="1100"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="SessionPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SessionSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF6FF" />
            <Setter Property="Foreground" Value="#0F3B63" />
            <Setter Property="BorderBrush" Value="#CFE0F3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E0F2FE" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BFDBFE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent">
        <wv2:WebView2 x:Name="LoginView" />
        <Border x:Name="UnlockedPanel"
                Visibility="Collapsed"
                BorderBrush="#DBE7F5"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Background="#F8FBFF"
                Cursor="Arrow">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  Direction="270"
                                  Opacity="0.18"
                                  ShadowDepth="4"
                                  Color="#2563EB" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Ellipse Width="8"
                         Height="8"
                         Fill="#10B981"
                         VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="当前上机"
                               FontSize="12"
                               Foreground="#64748B" />
                    <TextBlock x:Name="UserText"
                               Margin="0,3,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F3B63"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="2,0,10,0"
                            VerticalAlignment="Center">
                    <Button x:Name="LogoutButton"
                            Width="80"
                            Height="30"
                            Content="退出上机"
                            Click="OnLogoutClicked"
                            Style="{StaticResource SessionPrimaryButtonStyle}" />
                    <Button x:Name="MinimizeToTrayButton"
                            Width="80"
                            Height="28"
                            Margin="0,6,0,0"
                            Content="最小化"
                            Click="OnMinimizeToTrayClicked"
                            Style="{StaticResource SessionSecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
