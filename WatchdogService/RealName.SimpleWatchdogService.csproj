<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RealName.SimpleWatchdogService</AssemblyName>
    <!-- 与客户端同理：Win10 21H2（19044）内核对 CET 支持不完整，带 CET 标记的 .NET 10
         单文件 EXE 会在启动时 fail-fast（0x80131506），导致守护服务无法启动。 -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Common\BootLogReset.cs" Link="BootLogReset.cs" />
    <EmbeddedResource Include="watchdogsettings.jsonc" />
    <None Remove="watchdogsettings.jsonc" />
    <None Include="watchdogsettings.jsonc"
          Condition="'$(Configuration)' == 'Debug'"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <Content Include="install-service.bat" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="uninstall-service.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
